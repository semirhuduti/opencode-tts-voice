{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "npm run build *", "effect": "allow" },
    { "action": "shell", "resource": "npm test *", "effect": "allow" },
    { "action": "shell", "resource": "npm install *", "effect": "allow" },
    { "action": "shell", "resource": "npm pack --dry-run *", "effect": "allow" },
    { "action": "shell", "resource": "sh build-and-test.sh *", "effect": "allow" },
    { "action": "shell", "resource": "bun test *", "effect": "allow" },
    { "action": "shell", "resource": "bun run ./scripts/build-tui.ts *", "effect": "allow" },
    { "action": "shell", "resource": "node --check *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "npm publish *", "effect": "deny" },
    { "action": "shell", "resource": "npm run publish:npm *", "effect": "deny" },
    { "action": "shell", "resource": "sh publish-npm.sh *", "effect": "deny" },
    { "action": "shell", "resource": "bash publish-npm.sh *", "effect": "deny" },
    { "action": "shell", "resource": "./publish-npm.sh *", "effect": "deny" },
  ],
}
