{
  "name": "@scotteza/opencode-spoken-replies",
  "version": "1.0.8",
  "description": "Local Kokoro text-to-speech for OpenCode assistant replies",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tts",
    "voice",
    "kokoro",
    "tui",
    "spoken-replies"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server-plugin.d.ts",
      "import": "./dist/server-plugin.js"
    },
    "./tui": {
      "types": "./dist/tui-plugin.d.ts",
      "import": "./dist/tui-plugin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && bun run ./scripts/build-tui.ts",
    "test": "bun test",
    "test:audio": "bun ./scripts/test-audio.mjs",
    "publish:npm": "npm publish --access public",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0",
    "opencode": "^2.3.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scotteza/opencode-spoken-replies.git"
  },
  "homepage": "https://github.com/scotteza/opencode-spoken-replies",
  "bugs": {
    "url": "https://github.com/scotteza/opencode-spoken-replies/issues"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.1",
    "@opencode/client": "2.3.2",
    "@opencode/plugin": "2.3.2",
    "@opencode/theme": "2.3.2",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "kokoro-js": "^1.2.1",
    "solid-js": "1.9.17"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.5"
    },
    "glob@>=9 <14.0.2": "14.0.6",
    "minimatch@>=7 <11.0.1": "11.0.9"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
